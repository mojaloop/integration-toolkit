# DFSP identity
DFSP_ID=
DFSP_FQDN=
DFSP_CURRENCIES=XXX

# Hub endpoints (provided by Mojaloop hub operator)
MCM_SERVER_ENDPOINT=
HUB_IAM_PROVIDER_URL=
HUB_EXTAPI_FQDN=

# DFSP credentials (issued during hub enrollment)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Core connector endpoint (host:port reachable from the SDK container).
# Default points at the bundled mojaloop-simulator (started via --profile test).
# In production, deploy your own core banking system and set this to its address.
BACKEND_ENDPOINT=sim-backend:3000

# Logging
LOG_LEVEL=info

# Host port mappings
HOST_PORT_MCM=3001
HOST_PORT_VAULT=8200
HOST_PORT_REDIS=6379
HOST_PORT_SDK_INBOUND=443
HOST_PORT_SDK_OUTBOUND=4001

# Test-profile only (mojaloop-simulator)
HOST_PORT_SIM=3003
HOST_PORT_SIM_TEST=3004
